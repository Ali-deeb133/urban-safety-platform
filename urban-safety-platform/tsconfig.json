{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "isolatedModules": true,
    "moduleDetection": "force",
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "prisma", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
