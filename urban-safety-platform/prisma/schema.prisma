generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CITIZEN
  STAFF
  ADMIN
}

enum ReportStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum OrganizationType {
  MUNICIPALITY
  TRANSPORT
  UTILITY
  OTHER
}

/// One row per Supabase auth user. `id` equals `auth.users.id`; that foreign key
/// and the STAFF check constraint are added by hand in the init migration.
model Profile {
  id             String   @id @db.Uuid
  fullName       String
  role           Role
  organizationId String?  @db.Uuid
  areaId         String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  area         Area?         @relation(fields: [areaId], references: [id], onDelete: Restrict)

  reportedReports Report[]        @relation("ReportReporter")
  assignedReports Report[]        @relation("ReportAssignee")
  confirmations   Confirmation[]
  statusChanges   StatusHistory[]
}

model Organization {
  id   String           @id @default(uuid()) @db.Uuid
  name String           @unique
  type OrganizationType

  profiles            Profile[]
  responsibilityRules ResponsibilityRule[]
  reports             Report[]
}

model Area {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  profiles            Profile[]
  responsibilityRules ResponsibilityRule[]
  reports             Report[]
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  isEmergency Boolean @default(false)

  responsibilityRules ResponsibilityRule[]
  reports             Report[]
}

model ResponsibilityRule {
  id             String   @id @default(uuid()) @db.Uuid
  categoryId     String   @db.Uuid
  areaId         String   @db.Uuid
  organizationId String   @db.Uuid
  priority       Int      @default(1)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  area         Area         @relation(fields: [areaId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([categoryId, areaId, priority])
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  trackingNumber String       @unique
  categoryId     String       @db.Uuid
  areaId         String       @db.Uuid
  organizationId String?      @db.Uuid
  description    String
  imagePath      String?
  status         ReportStatus @default(PENDING)
  reporterId     String?      @db.Uuid
  assignedToId   String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  area         Area          @relation(fields: [areaId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reporter     Profile?      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedTo   Profile?      @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  confirmations Confirmation[]
  statusHistory StatusHistory[]




  @@index([organizationId, areaId, status, createdAt]) 
  @@index([categoryId, areaId, status, createdAt])
  @@index([reporterId])
}

model Confirmation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  reportId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report  @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@unique([userId, reportId])
}

model StatusHistory {
  id          String        @id @default(uuid()) @db.Uuid
  reportId    String        @db.Uuid
  fromStatus  ReportStatus?
  toStatus    ReportStatus
  changedById String?       @db.Uuid
  note        String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  report    Report   @relation(fields: [reportId], references: [id], onDelete: Restrict)
  changedBy Profile? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
}
